# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string (same Atlas cluster as your Vercel app)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Shared secret — Vercel app sends this in every request header (x-wa-secret)
# Generate with: openssl rand -hex 32
SERVER_SECRET=replace_with_a_long_random_secret

# Base URL of your Next.js Vercel app (must end with /)
# Used to call the Pinecone similarity search API
NEXT_PUBLIC_WEBSITE_URL=https://your-app.vercel.app/

# OpenAI key for AI replies
NEXT_PUBLIC_OPENAI_KEY=sk-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (Cloud Run sets this automatically)
PORT=3001

# Override the default DB name from the URI if needed
# MONGO_DB_NAME=my_custom_db
